# Copy to .env and fill in. .env is git-ignored; never commit it.

# The address your friends will open. Its DNS A record must point at the VPS.
DOMAIN=habitat.example.com

# Name shown in the server sidebar.
SERVER_NAME=Habitat

# Register with exactly this username first to become admin.
ADMIN_USERNAME=

# Shared secret between Habitat and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=
